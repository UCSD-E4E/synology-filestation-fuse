<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SynologyFuse.Gui.ViewModels"
        x:Class="SynologyFuse.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="NAS Folder Access"
        Width="520"
        MinWidth="400"
        SizeToContent="Height"
        CanResize="True">

  <DockPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

        <!-- How the NAS is being reached. The difference between these is the
             difference between a transfer that resumes where it stopped and one
             that starts again, and nothing else in the UI says which you got.
             Hidden until something has connected, so it never shows a guess. -->
        <Border Grid.Column="1"
                IsVisible="{Binding HasTransport}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                CornerRadius="3"
                Padding="7,2"
                Margin="0,0,10,0"
                ToolTip.Tip="{Binding TransportDetail}">
          <TextBlock Text="{Binding TransportBadge}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Border>

        <TextBlock Grid.Column="2"
                   Text="{Binding Version}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </Grid>
    </Border>

    <!-- Log output -->
    <Border DockPanel.Dock="Bottom" Height="160" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer>
        <TextBox Text="{Binding LogOutput}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Padding="8" />
      </ScrollViewer>
    </Border>

    <!-- Main form -->
    <ScrollViewer>
      <!-- Grid.IsSharedSizeScope: every label/field row below sizes its label
           column to the widest label in the form (SharedSizeGroup="FormLabel"),
           so the rows stay aligned without any row pinning the column to a
           pixel width its own text may outgrow. -->
      <StackPanel Margin="20" Spacing="4" Grid.IsSharedSizeScope="True">

        <!-- Error banner. Sits above the form, next to the fields it talks
             about: the headline names the cause, the line under it names the
             fix, and the small print carries the raw message for a bug report. -->
        <Border IsVisible="{Binding ErrorBanner.IsVisible}"
                Background="#F8D7DA"
                BorderBrush="#F1AEB5"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding ErrorBanner.Title}"
                         FontWeight="SemiBold"
                         Foreground="#721C24"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ErrorBanner.Remedy}"
                         Foreground="#721C24"
                         TextWrapping="Wrap" />
              <!-- Selectable so the raw message can be copied into an issue. -->
              <SelectableTextBlock Text="{Binding ErrorBanner.Detail}"
                                   IsVisible="{Binding ErrorBanner.HasDetail}"
                                   Foreground="#721C24"
                                   Opacity="0.75"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Dismiss"
                    Command="{Binding ErrorBanner.DismissCommand}"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0" />
          </Grid>
        </Border>

        <!-- Update available banner -->
        <Border IsVisible="{Binding ShowUpdateBanner}"
                Background="#D1ECF1"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,0,0,10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Foreground="#0C5460">
                <Run Text="Update available: v" /><Run Text="{Binding UpdateVersion}" />
              </TextBlock>
              <TextBlock Text="A newer release is available on GitHub."
                         Foreground="#0C5460"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="View"
                    Command="{Binding OpenUpdateUrlCommand}"
                    Margin="8,0,4,0" />
            <Button Grid.Column="2"
                    Content="Dismiss"
                    Command="{Binding DismissUpdateBannerCommand}" />
          </Grid>
        </Border>

        <!-- Connection section -->
        <TextBlock Text="Connection"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,4" />

        <!-- Host -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox   Grid.Column="1" Text="{Binding Host}"
                     PlaceholderText="192.168.1.100 or nas.local"
                     IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- Username -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Username" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox   Grid.Column="1" Text="{Binding Username}"
                     PlaceholderText="admin"
                     IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- Password -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox   Grid.Column="1" Text="{Binding Password}"
                     PasswordChar="●"
                     IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- Port -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,12,0" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding Port}"
                         Minimum="1" Maximum="65535" Increment="1"
                         FormatString="0"
                         IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- HTTPS -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="HTTPS" VerticalAlignment="Center" Margin="0,0,12,0" />
          <CheckBox  Grid.Column="1"
                     IsChecked="{Binding UseHttps}"
                     Content="Use HTTPS"
                     IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- Certificate verification. Off means the connection is encrypted but
             not authenticated, so it is presented as the exception, not a peer
             of "Use HTTPS". -->
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Certificate" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1">
            <CheckBox IsChecked="{Binding VerifySsl}"
                      Content="Verify the NAS TLS certificate"
                      IsEnabled="{Binding IsDisconnected}" />
            <TextBlock Text="Untick only for a self-signed DSM certificate. The connection stays encrypted, but nothing proves you are talking to your NAS."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.7"
                       IsVisible="{Binding !VerifySsl}"
                       Margin="24,2,0,0" />
          </StackPanel>
        </Grid>

        <!-- Volume section. "Mount" is what the driver does; "volume" is what
             the user ends up with, and it is the word the rest of the UI uses. -->
        <TextBlock Text="Volume"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,12,0,4" />

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Volume location" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox   Grid.Column="1" Text="{Binding Mountpoint}"
                     PlaceholderText="/mnt/nas  •  /Volumes/nas  •  Z:\"
                     IsEnabled="{Binding IsDisconnected}" />
        </Grid>

        <!-- How the NAS is reached. Both of these decide whether transfers go
             over SMB or fall back to the slower FileStation API, and neither is
             discoverable from anywhere else. -->
        <TextBlock Text="Access"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,12,0,4" />

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Domain" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1">
            <TextBox Text="{Binding Domain}"
                     PlaceholderText="empty for a local DSM user"
                     IsEnabled="{Binding IsDisconnected}" />
            <TextBlock Text="An account from a directory the NAS is joined to needs its domain here. Without it SMB cannot authenticate and transfers quietly use the slower FileStation API instead, and the VPN is refused before your password is even checked."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.7"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="NAS address in VPN" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Column="1">
            <TextBox Text="{Binding VpnHost}"
                     PlaceholderText="the private address the NAS answers on inside the tunnel"
                     IsEnabled="{Binding IsDisconnected}" />
            <TextBlock Text="Set this to reach the NAS through a VPN when it does not answer directly. The tunnel is raised inside this application — nothing is installed, and nothing else on the machine is affected. The address differs from the name above because the tunnel carries no DNS."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.7"
                       Margin="0,2,0,0" />
          </StackPanel>
        </Grid>

        <!-- Two places, asked separately: one field for "the VPN profile"
             invites the NAS's path into a setting that names a file on this
             disk, and the connection then fails trying to create that
             directory here. -->
        <StackPanel IsVisible="{Binding VpnHost, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profile on the NAS" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
              <TextBox Text="{Binding VpnProfileNas}"
                       PlaceholderText="path to the .ovpn file on the NAS"
                       IsEnabled="{Binding IsDisconnected}" />
              <TextBlock Text="Downloaded over the connection you are making now and kept with your settings, which is how you get the profile when you cannot yet reach the NAS any other way. Ask whoever set the NAS up where it is published."
                         TextWrapping="Wrap"
                         FontSize="11"
                         Opacity="0.7"
                         Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Profile on this computer" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
              <TextBox Text="{Binding VpnProfile}"
                       PlaceholderText="path to an .ovpn file you already have"
                       IsEnabled="{Binding IsDisconnected}" />
              <TextBlock Text="Use a file you were given instead of downloading one. Leave empty to use the downloaded copy."
                         TextWrapping="Wrap"
                         FontSize="11"
                         Opacity="0.7"
                         Margin="0,2,0,0" />
            </StackPanel>
          </Grid>

        </StackPanel>

        <!-- Advanced section -->
        <Expander Header="Advanced" Margin="0,10,0,0" IsEnabled="{Binding IsDisconnected}">
          <StackPanel Margin="0,8,0,0" Spacing="0">

            <!-- Cache TTL -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Cache TTL (s)" VerticalAlignment="Center" Margin="0,0,12,0" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding CacheTtl}"
                             Minimum="0" Maximum="3600" FormatString="0" />
            </Grid>

            <!-- Read cache -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Read cache (MiB)" VerticalAlignment="Center" Margin="0,0,12,0" />
              <NumericUpDown Grid.Column="1"
                             Value="{Binding ReadCacheMb}"
                             Minimum="0" Maximum="65536" FormatString="0" />
            </Grid>

            <!-- Log level -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="FormLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Log level" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox  Grid.Column="1"
                         ItemsSource="{Binding LogLevels}"
                         SelectedItem="{Binding LogLevel}"
                         HorizontalAlignment="Stretch" />
            </Grid>

          </StackPanel>
        </Expander>

        <!-- 2FA banner: appears when login reports that an OTP code is required -->
        <Border IsVisible="{Binding ShowOtpPrompt}"
                Background="#FFF3CD"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,10,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Two-factor authentication code required."
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="#856404" />
            <TextBlock Text="Enter your TOTP code below to finish connecting."
                       TextWrapping="Wrap"
                       Foreground="#856404" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding PendingOtp, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="6-digit TOTP code"
                       Margin="0,0,8,0">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SubmitOtpCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1"
                      Content="Submit"
                      Command="{Binding SubmitOtpCommand}"
                      Classes="accent" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Progress and buttons. The spinner has a line of its own: sharing
             one with the buttons made the row wider than the window, and a
             Grid does not clip, so the buttons were drawn over each other and
             the last one off the edge. -->
        <StackPanel Orientation="Horizontal" Spacing="8"
                    Margin="0,16,0,0"
                    IsVisible="{Binding IsConnecting}">
          <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                       VerticalAlignment="Center" />
          <TextBlock Text="Working…" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- No fixed widths: a button pinned to a pixel width hides its own
             label under a larger font, and a row of them runs off the side of
             the window. MinWidth keeps the short labels from looking cramped,
             and the connect buttons wrap onto another line when there is no
             room for them side by side. -->
        <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,4">
          <Button Grid.Column="0"
                  Content="Browse…"
                  Click="OnBrowse"
                  IsEnabled="{Binding IsIdle}"
                  MinWidth="96"
                  VerticalAlignment="Top"
                  Margin="0,4,8,0" />

          <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
            <Button Content="Test Connection"
                    Command="{Binding TestConnectionCommand}"
                    MinWidth="96"
                    Margin="8,4,0,0" />
            <Button Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Classes="accent"
                    IsDefault="True"
                    MinWidth="96"
                    Margin="8,4,0,0" />
            <Button Content="Disconnect"
                    Command="{Binding DisconnectCommand}"
                    MinWidth="96"
                    Margin="8,4,0,0" />
          </WrapPanel>
        </Grid>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
